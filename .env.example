# Connect to Supabase via connection pooling
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Client
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"

# Key for AES-256-GCM (32 bytes = 64 hex chars). REQUIRED - the app refuses to start embedding without it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STEGANOGRAPHY_KEY="[YOUR-32-BYTE-HEX-KEY]"

# Secret used to sign login session cookies (min 32 chars). REQUIRED.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="[YOUR-RANDOM-SECRET]"

# Ed25519 seed (32 bytes = 64 hex) that signs certificate seals. REQUIRED for issuing seals.
# Generate with: npm run seal:keygen -- <kid>   (paste the printed public key into src/lib/seal/public-keys.ts)
SEAL_SIGNING_KEY="[YOUR-ED25519-SEED-HEX]"

# Supabase service role key (server only, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# Temporary: set to "true" only to still verify certificates embedded before the key fix
# (they were encrypted with a publicly known default key). Re-approve those certificates, then remove this.
# ALLOW_LEGACY_STEGO_KEY="true"

# Do NOT set NODE_TLS_REJECT_UNAUTHORIZED=0: it disables TLS verification for the whole process.
# The database pool already handles the Supabase pooler certificate chain (see src/lib/prisma.ts).
